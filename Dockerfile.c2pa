FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    MEDIAFORGE_ARTIFACT_ROOT=/var/lib/mediaforge/artifacts \
    MEDIAFORGE_STATE_BACKEND=sqlite \
    MEDIAFORGE_AUTH_MODE=required

WORKDIR /app
COPY pyproject.toml README.md ./
COPY src ./src
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir '.[enterprise,agents]'

# The binary is fetched and hash-verified by ops/c2pa/install-c2patool.ps1.
# Keeping this download outside Docker makes builds reproducible in restricted
# production networks and avoids placing a private signing credential in image layers.
COPY ops/c2pa/bin/c2patool /usr/local/bin/c2patool
RUN chmod 0755 /usr/local/bin/c2patool \
    && c2patool --version \
    && mkdir -p /var/lib/mediaforge/artifacts

VOLUME ["/var/lib/mediaforge"]
