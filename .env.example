MEDIAFORGE_AUTH_MODE=required
MEDIAFORGE_API_KEYS={"studio-admin":{"subject":"ops","role":"admin"},"studio-editor":{"subject":"producer","role":"editor","tenant_id":"tenant_a"}}
MEDIAFORGE_CALLBACK_SECRET=replace-with-a-long-random-secret
MEDIAFORGE_CALLBACK_MAX_AGE_SECONDS=300
# Approved real Provider probes can write a signed release receipt. Keep this
# value in the secret manager; strict acceptance reads it from a protected file.
# MEDIAFORGE_PROVIDER_PROBE_RECEIPT_SECRET=replace-with-a-distinct-32-character-minimum-secret
# MEDIAFORGE_PROVIDER_PROBE_RECEIPT_SECRET_FILE=/run/secrets/provider-probe-receipt-secret
# MEDIAFORGE_PROVIDER_PROBE_RECEIPTS=/var/lib/mediaforge/evidence/comfyui-probe.json,/var/lib/mediaforge/evidence/replicate-probe.json
# MEDIAFORGE_PROVIDER_PROBE_MAX_AGE_HOURS=168
MEDIAFORGE_PROVIDER=mock
# Optional multi-provider routing pool. The first entry has highest priority.
# MEDIAFORGE_PROVIDERS=mock,comfyui,replicate

# Optional OpenAI-compatible story and storyboard planner
# MEDIAFORGE_PLANNING_MODE=langgraph
# Staged drafts require the agents extra and persist under ARTIFACT_ROOT/.planning.
# Without an external LLM, stages use local deterministic data and cannot auto-revise.
# PostgreSQL uses LangGraph's shared checkpointer and advisory locks. Use a dedicated
# database because the upstream saver owns its checkpoint tables; it never reuses state tables.
# MEDIAFORGE_PLANNING_CHECKPOINT_BACKEND=postgres
# MEDIAFORGE_PLANNING_DATABASE_URL=postgresql://mediaforge_planning:replace-me@postgres:5432/mediaforge_planning
# MEDIAFORGE_LLM_MODE=openai_compatible
# MEDIAFORGE_LLM_BASE_URL=http://127.0.0.1:4000/v1
# MEDIAFORGE_LLM_API_KEY=replace-with-llm-key
# MEDIAFORGE_LLM_MODEL=your-model-name
# MEDIAFORGE_LLM_TIMEOUT_SECONDS=60
# MEDIAFORGE_LLM_RETRY_ATTEMPTS=2
# MEDIAFORGE_LLM_RETRY_BACKOFF_SECONDS=0.5

# Optional scan-PDF OCR. Disabled by default. OCR is used only for imports that
# explicitly set allow_external_processing=true. HTTP receives JSON with
# filename, mime_type and content_b64 and must return {"text":"..."}.
# MEDIAFORGE_OCR_MODE=http
# MEDIAFORGE_OCR_URL=https://ocr.example.com/v1/extract
# Command mode is a JSON argv array and must include separate {input} and {output} items.
# MEDIAFORGE_OCR_MODE=command
# MEDIAFORGE_OCR_COMMAND=["/opt/mediaforge/bin/ocr-pdf","{input}","{output}"]
# MEDIAFORGE_OCR_TIMEOUT_SECONDS=30

# Project-scoped RAG: sqlite (local BM25), pgvector (TEI embeddings), or
# ragflow (read-only retrieval from explicitly mapped, curated RAGFlow datasets).
# MEDIAFORGE_RAG_BACKEND=sqlite
# MEDIAFORGE_RAG_ENABLED=true
# MEDIAFORGE_RAG_TOP_K=8
# MEDIAFORGE_RAG_MAX_CONTEXT_CHARS=8000
# pgvector requires enterprise dependencies and the operator SQL migration.
# Never use a superuser/BYPASSRLS role for the API. See docs/semantic-memory.md.
# MEDIAFORGE_RAG_DATABASE_URL=postgresql://mediaforge_rag:replace-me@localhost:5432/mediaforge
# MEDIAFORGE_RAG_NAMESPACE=studio-production
# MEDIAFORGE_RAG_MIN_SIMILARITY=0.25
# MEDIAFORGE_RAG_CHUNK_CHARS=384
# MEDIAFORGE_RAG_CHUNK_OVERLAP=48
# MEDIAFORGE_EMBEDDING_URL=http://127.0.0.1:8080/embed
# MEDIAFORGE_EMBEDDING_MODEL=your-deployed-model-id
# MEDIAFORGE_EMBEDDING_REVISION=your-pinned-model-commit
# MEDIAFORGE_EMBEDDING_DIMENSIONS=768
# MEDIAFORGE_EMBEDDING_TOKEN=
# MEDIAFORGE_EMBEDDING_TIMEOUT_SECONDS=30
# MEDIAFORGE_EMBEDDING_QUERY_PREFIX=
# MEDIAFORGE_EMBEDDING_DOCUMENT_PREFIX=
# Opt in only after authorizing project text transmission to the configured TEI service.
# MEDIAFORGE_EMBEDDING_ALLOW_DATA_EXPORT=false

# RAGFlow retrieval is read-only by default. Map each local tenant/project source
# to pre-curated RAGFlow dataset IDs explicitly. The external retrieval endpoint
# receives user questions only when this opt-in is true.
# MEDIAFORGE_RAG_BACKEND=ragflow
# MEDIAFORGE_RAGFLOW_BASE_URL=https://ragflow.example.com
# MEDIAFORGE_RAGFLOW_API_KEY=replace-with-ragflow-api-key
# MEDIAFORGE_RAGFLOW_DATASET_MAP={"tenant_a":{"brand-library":["ragflow-dataset-id"]}}
# MEDIAFORGE_RAGFLOW_ALLOW_DATA_EXPORT=false
# A separate opt-in permits an editor to manually upload a content-addressed
# snapshot of approved story material. It is never triggered by retrieval or planning.
# MEDIAFORGE_RAGFLOW_ALLOW_WRITE_SYNC=false
# MEDIAFORGE_RAGFLOW_MAX_SYNC_BYTES=5000000
# MEDIAFORGE_RAGFLOW_TIMEOUT_SECONDS=15
# MEDIAFORGE_RAGFLOW_SIMILARITY_THRESHOLD=0.2
# MEDIAFORGE_RAGFLOW_VECTOR_SIMILARITY_WEIGHT=0.3

# Optional audit event webhooks, comma-separated
# MEDIAFORGE_WEBHOOK_URLS=https://ops.example.com/mediaforge/events
# MEDIAFORGE_WEBHOOK_SECRET=replace-with-webhook-secret
# MEDIAFORGE_WEBHOOK_TIMEOUT_SECONDS=5
# MEDIAFORGE_WEBHOOK_RETRY_ATTEMPTS=2
# MEDIAFORGE_WEBHOOK_RETRY_BACKOFF_SECONDS=0.5

# Optional SIEM audit sink. It sends a CloudEvents 1.0 metadata envelope only:
# audit message text and details values never leave MediaForge. HTTPS and an
# explicit destination hostname allowlist are required in production.
# MEDIAFORGE_SIEM_URLS=https://siem.example.com/ingest/mediaforge
# MEDIAFORGE_SIEM_ALLOWED_HOSTS=siem.example.com
# MEDIAFORGE_SIEM_BEARER_TOKEN=replace-with-siem-token
# MEDIAFORGE_SIEM_SIGNING_SECRET=replace-with-siem-signing-secret
# MEDIAFORGE_SIEM_SOURCE=urn:mediaforge:production
# MEDIAFORGE_SIEM_TIMEOUT_SECONDS=5
# MEDIAFORGE_SIEM_RETRY_ATTEMPTS=2
# MEDIAFORGE_SIEM_RETRY_BACKOFF_SECONDS=0.5
# Set only for an isolated local test endpoint; production must use HTTPS.
# MEDIAFORGE_SIEM_ALLOW_INSECURE_HTTP=false

# Optional external audit-chain anchor. Choose Object Lock for a separately
# administered S3-compatible WORM bucket, or HTTP for a signed notary service.
# A local filesystem store is intentionally never treated as an immutable anchor.
# MEDIAFORGE_AUDIT_ANCHOR_MODE=object_lock
# MEDIAFORGE_AUDIT_ANCHOR_RETENTION_DAYS=3650
# MEDIAFORGE_AUDIT_ANCHOR_OBJECT_LOCK_MODE=COMPLIANCE
# MEDIAFORGE_AUDIT_ANCHOR_KEY_PREFIX=audit-anchors
# MEDIAFORGE_AUDIT_ANCHOR_MODE=http
# MEDIAFORGE_AUDIT_ANCHOR_URL=https://notary.example.com/v1/mediaforge/anchors
# MEDIAFORGE_AUDIT_ANCHOR_ALLOWED_HOSTS=notary.example.com
# MEDIAFORGE_AUDIT_ANCHOR_BEARER_TOKEN=replace-with-notary-token
# MEDIAFORGE_AUDIT_ANCHOR_SIGNING_SECRET=replace-with-notary-signing-secret
# MEDIAFORGE_AUDIT_ANCHOR_TIMEOUT_SECONDS=10
# Set only for an isolated local test endpoint; production must use HTTPS.
# MEDIAFORGE_AUDIT_ANCHOR_ALLOW_INSECURE_HTTP=false

# Tenant quota governance (leave empty for unlimited local development)
# MEDIAFORGE_TENANT_MAX_PROJECTS=50
# MEDIAFORGE_TENANT_MAX_JOBS=500
# MEDIAFORGE_TENANT_BUDGET=1000
# MEDIAFORGE_TENANT_QUOTAS={"tenant_a":{"max_projects":20,"max_jobs":200,"max_budget":500}}

# ComfyUI production settings
# MEDIAFORGE_PROVIDER=comfyui
# COMFYUI_BASE_URL=http://host.docker.internal:8188
# COMFYUI_WORKFLOW_PATH=/app/data/workflows/comfyui_image_workflow.json
# Single-workflow provenance and optional strict content pin.
# COMFYUI_WORKFLOW_TEMPLATE_ID=legacy-default
# COMFYUI_WORKFLOW_VERSION=2026.09.15
# COMFYUI_WORKFLOW_SHA256=replace-with-64-character-workflow-sha256
# COMFYUI_REQUIRE_WORKFLOW_PIN=false
# A registry maps MediaForge template_id values to reviewed ComfyUI graphs.
# COMFYUI_WORKFLOW_REGISTRY_PATH=/app/config/comfyui-workflow-registry.json

# Replicate production settings
# MEDIAFORGE_PROVIDER=replicate
# REPLICATE_API_TOKEN=replace-with-provider-token
# REPLICATE_MODEL_VERSION=replace-with-pinned-model-version
# REPLICATE_TIMEOUT_SECONDS=180
# Bound manual and timeout-triggered cancellation calls independently from generation.
# REPLICATE_CANCEL_REQUEST_TIMEOUT_SECONDS=15
# REPLICATE_POLL_INTERVAL_SECONDS=1
# REPLICATE_CANCEL_AFTER_SECONDS=180
# REPLICATE_HTTP_RETRY_ATTEMPTS=2
# REPLICATE_HTTP_RETRY_BACKOFF_SECONDS=0.5
# Do not occupy a Worker for a longer provider Retry-After; schedule the Job instead.
# REPLICATE_HTTP_RETRY_MAX_DELAY_SECONDS=15
# Optional native asynchronous callback mode for a public MediaForge API.
# REPLICATE_WEBHOOK_URL_TEMPLATE=https://studio.example.com/providers/replicate/webhook?project_id={project_id}&job_id={job_id}
# REPLICATE_WEBHOOK_SIGNING_SECRET=whsec_replace-with-provider-webhook-secret
# REPLICATE_WEBHOOK_MAX_AGE_SECONDS=300

# Local GPU Provider. The command receives request JSON on stdin and must
# create MEDIAFORGE_OUTPUT_PATH as a readable PNG or MP4.
# MEDIAFORGE_PROVIDER=local
# MEDIAFORGE_LOCAL_PROVIDER_COMMAND=python path/to/local_media_worker.py
# MEDIAFORGE_LOCAL_PROVIDER_CAPABILITIES=image_generation,image_to_video
# MEDIAFORGE_LOCAL_PROVIDER_TIMEOUT_SECONDS=900
# MEDIAFORGE_LOCAL_PROVIDER_HEALTH_COMMAND=python path/to/local_media_worker.py --health
# MEDIAFORGE_LOCAL_PROVIDER_WARMUP_COMMAND=python path/to/local_media_worker.py --warmup
# MEDIAFORGE_LOCAL_PROVIDER_ESTIMATED_COST=0

# Delivery dispatch (local by default; file:// and HTTP(S) are supported)
# MEDIAFORGE_DELIVERY_MODE=local
# MEDIAFORGE_DELIVERY_TIMEOUT_SECONDS=30
# MEDIAFORGE_DELIVERY_RETRIES=2
# MEDIAFORGE_DELIVERY_SECRET=optional-hmac-secret

# Optional external quality evaluator. Data export is opt-in and disabled by default.
# MEDIAFORGE_QUALITY_URL=https://quality.example.com/evaluate
# MEDIAFORGE_QUALITY_TOKEN=replace-with-quality-token
# MEDIAFORGE_QUALITY_ALLOW_DATA_EXPORT=false
# MEDIAFORGE_QUALITY_FAIL_OPEN=true
# MEDIAFORGE_QUALITY_TIMEOUT_SECONDS=15
# MEDIAFORGE_QUALITY_RETRIES=1
# Local sampled-frame exposure/contrast gate; false keeps diagnostics advisory.
# MEDIAFORGE_VISUAL_GATE=false

# Optional Langfuse v4 observability. Install with `pip install -e .[observability]`.
# The adapter sends redacted generation/evaluation metadata by default; it does not
# replace MediaForge's local audit ledger. Store both Langfuse credentials in files.
# MEDIAFORGE_LANGFUSE_ENABLED=true
# MEDIAFORGE_LANGFUSE_PUBLIC_KEY_FILE=/run/secrets/langfuse-public-key
# MEDIAFORGE_LANGFUSE_SECRET_KEY_FILE=/run/secrets/langfuse-secret-key
# MEDIAFORGE_LANGFUSE_BASE_URL=https://cloud.langfuse.com
# MEDIAFORGE_LANGFUSE_ENVIRONMENT=staging
# MEDIAFORGE_LANGFUSE_SAMPLE_RATE=1
# Set true only after a data-export assessment approves prompt/body transfer.
# MEDIAFORGE_LANGFUSE_INCLUDE_PROMPT_CONTENT=false

# Six-stage production workflow. The Studio always exposes stage evidence,
# locks and rework impact. Enable this only after teams adopt the review gates:
# generation requires locked assets, export requires locked video, packaging
# requires locked postproduction, and release requires locked delivery.
# MEDIAFORGE_REQUIRE_STAGE_LOCKS=true
# Require the current final MP4, rather than any project asset, to have a
# SIGNED_VERIFIED C2PA content credential before the release API can succeed.
# MEDIAFORGE_REQUIRE_RELEASE_CONTENT_CREDENTIALS=true

# Optional centralized license registry sync
# MEDIAFORGE_LICENSE_REGISTRY_SYNC_URL=https://governance.example.com/mediaforge/registry.json
# MEDIAFORGE_LICENSE_REGISTRY_SYNC_ALLOWED_HOSTS=governance.example.com
# MEDIAFORGE_LICENSE_REGISTRY_SYNC_TOKEN=replace-with-registry-token
# MEDIAFORGE_LICENSE_REGISTRY_SYNC_INTERVAL_SECONDS=3600
# Set true in production to require an active `kind: asset` registry record for
# every uploaded reference/source SHA-256. Records support valid_from,
# valid_until, evidence, and rights_uri for contract evidence.
# MEDIAFORGE_REQUIRE_ASSET_RIGHTS_RECORD=true

# Enterprise runtime adapters
# MEDIAFORGE_AUTH_MODE=oidc
# MEDIAFORGE_OIDC_INTROSPECTION_URL=https://login.example.com/oauth2/introspect
# MEDIAFORGE_OIDC_CLIENT_ID=mediaforge
# MEDIAFORGE_OIDC_CLIENT_SECRET=replace-with-oidc-client-secret
# MEDIAFORGE_OIDC_TIMEOUT_SECONDS=5
# MEDIAFORGE_OIDC_ISSUER=https://login.example.com/realms/mediaforge
# Browser SSO uses authorization code + PKCE; leave unset for API-token-only mode.
# MEDIAFORGE_OIDC_AUTHORIZATION_URL=https://login.example.com/oauth2/authorize
# MEDIAFORGE_OIDC_TOKEN_URL=https://login.example.com/oauth2/token
# MEDIAFORGE_OIDC_REDIRECT_URI=https://mediaforge.example.com/auth/callback
# MEDIAFORGE_OIDC_SCOPE=openid profile email
# Directory/IdP federation mapping. A SAML, LDAP/AD, or SCIM-enabled IdP should
# manage users and emit OIDC claims; MediaForge maps approved external groups to
# its local roles without storing directory credentials.
# MEDIAFORGE_OIDC_ROLE_CLAIM=groups
# MEDIAFORGE_OIDC_TENANT_CLAIM=organization.id
# MEDIAFORGE_OIDC_ROLE_MAPPING={"mediaforge-editors":"editor","mediaforge-publishers":"publisher"}
# MEDIAFORGE_OIDC_SESSION_TTL_SECONDS=43200
# MEDIAFORGE_OIDC_COOKIE_SECURE=true
# Browser OIDC state/session storage. auto uses PostgreSQL in leased control-plane
# mode and memory otherwise; PostgreSQL preserves login sessions during failover.
# MEDIAFORGE_OIDC_SESSION_BACKEND=auto
# MEDIAFORGE_OIDC_SESSION_TABLE=mediaforge_oidc_session
# MEDIAFORGE_STORAGE_MODE=local
# MEDIAFORGE_STORAGE_ENDPOINT=https://s3.example.com
# MEDIAFORGE_STORAGE_BUCKET=mediaforge-artifacts
# MEDIAFORGE_QUEUE_BACKEND=sqlite
# MEDIAFORGE_REDIS_URL=redis://redis:6379/0
# MEDIAFORGE_REDIS_QUEUE=mediaforge:jobs
# Optional GPU admission for the remote Worker CLI.
# MEDIAFORGE_WORKER_MIN_GPU_MEMORY_MIB=0
# A GPU Worker runs the configured Provider on its own GPU and returns signed
# callbacks to the API. It requires a shared writable artifact root, a Provider
# command/model stack available inside the Worker image, and CALLBACK_SECRET.
# MEDIAFORGE_WORKER_EXECUTION_MODE=local-provider-callback
# MEDIAFORGE_WORKER_ARTIFACT_ROOT=/var/lib/mediaforge/artifacts
# MEDIAFORGE_WORKER_PROVIDER=local
# MEDIAFORGE_GPU_WORKER_CONCURRENCY=1
# MEDIAFORGE_STATE_BACKEND=postgres
# MEDIAFORGE_DATABASE_URL=postgresql://mediaforge:replace-me@postgres:5432/mediaforge
# MEDIAFORGE_STATE_TABLE=mediaforge_state
# Optional active/passive API control plane. Requires STATE_BACKEND=postgres and
# a shared MEDIAFORGE_ARTIFACT_ROOT volume; only the lease holder accepts writes.
# MEDIAFORGE_CONTROL_PLANE_MODE=leased
# MEDIAFORGE_CONTROL_PLANE_ID=mediaforge-api-a
# MEDIAFORGE_CONTROL_PLANE_LEASE_SECONDS=30
# MEDIAFORGE_CONTROL_PLANE_TABLE=mediaforge_control_plane_lease
# MEDIAFORGE_RATE_LIMIT_ENABLED=true
# MEDIAFORGE_RATE_LIMIT_BACKEND=sqlite
# MEDIAFORGE_RATE_LIMIT_REQUESTS=120
# Read-only workbench endpoints use an isolated bucket to avoid dashboard refreshes
# consuming the stricter mutation quota. Defaults to five times the write limit.
# MEDIAFORGE_RATE_LIMIT_READ_REQUESTS=600
# MEDIAFORGE_RATE_LIMIT_WINDOW_SECONDS=60
# Provider routing circuit breaker. This is process-local protection: after
# consecutive Provider errors, this API/Worker process temporarily routes to an
# available fallback. Use a shared control plane for fleet-wide coordination.
# MEDIAFORGE_PROVIDER_CIRCUIT_BREAKER_ENABLED=true
# MEDIAFORGE_PROVIDER_CIRCUIT_FAILURE_THRESHOLD=3
# MEDIAFORGE_PROVIDER_CIRCUIT_OPEN_SECONDS=60
# MEDIAFORGE_BILLING_DB=/var/lib/mediaforge/billing.sqlite3
# MEDIAFORGE_BILLING_CURRENCY=USD
# Optional signed settlement callback for an approved payment gateway or ERP
# adapter. The caller posts canonical settlement JSON to
# /billing/settlements/callback with X-MediaForge-Timestamp and
# X-MediaForge-Signature: sha256=HMAC(secret, timestamp + '.' + raw_body).
# MEDIAFORGE_SETTLEMENT_CALLBACK_SECRET=keep-in-your-secret-manager
# MEDIAFORGE_SETTLEMENT_CALLBACK_ALLOWED_PROVIDERS=stripe,alipay,wechat_pay,erp
# MEDIAFORGE_SETTLEMENT_CALLBACK_MAX_AGE_SECONDS=300
# Optional native Stripe payout webhook. Stripe signs the unmodified request body
# with the endpoint secret; each payout must include metadata.mediaforge_tenant_id.
# MEDIAFORGE_STRIPE_SETTLEMENT_WEBHOOK_SECRET=whsec_replace-with-stripe-endpoint-secret
# MEDIAFORGE_STRIPE_SETTLEMENT_EVENT_TYPES=payout.paid,payout.failed,payout.canceled
# MEDIAFORGE_STRIPE_SETTLEMENT_MAX_AGE_SECONDS=300

# Operations alerts are computed locally and exposed at GET /ops/alerts and /metrics.
# They never send telemetry by themselves. Set REQUIRE_PRODUCTION_READY only for a
# deployed production control plane; local Mock development otherwise stays healthy.
# MEDIAFORGE_ALERT_QUEUE_DEPTH=25
# MEDIAFORGE_ALERT_QUEUE_WAIT_SECONDS=300
# MEDIAFORGE_ALERT_FAILURE_RATE=0.25
# MEDIAFORGE_ALERT_MIN_TERMINAL_JOBS=5
# MEDIAFORGE_ALERT_SPEND_RATIO=0.9
# MEDIAFORGE_ALERT_STALE_WORKER_SECONDS=900
# MEDIAFORGE_ALERT_REQUIRE_PRODUCTION_READY=false

# Read-only k6 capacity baseline. These variables are consumed by
# ops/load/studio-readonly.mjs, never by the MediaForge API process.
# MEDIAFORGE_LOAD_BASE_URL=https://staging.mediaforge.example
# MEDIAFORGE_LOAD_TOKEN=keep-in-your-secret-manager
# MEDIAFORGE_LOAD_PROJECT_ID=approved-staging-project
# MEDIAFORGE_LOAD_VUS=10
# MEDIAFORGE_LOAD_MAX_P95_MS=1000
# MEDIAFORGE_LOAD_MAX_FAILURE_RATE=0.01

# Optional Prometheus + Alertmanager + Grafana Compose overlay. The overlay forces
# token-protected /metrics and mounts these files as Docker secrets; do not put
# their contents in .env. The default target is mediaforge:8020. Use gateway:8080
# with docker-compose.ha.yml so Prometheus reaches the active lease holder.
# MEDIAFORGE_METRICS_AUTH_MODE=token
# MEDIAFORGE_METRICS_TOKEN_FILE=./ops/secrets/mediaforge-metrics-token
# MEDIAFORGE_GRAFANA_ADMIN_USER=admin
# MEDIAFORGE_GRAFANA_ADMIN_PASSWORD_FILE=./ops/secrets/grafana-admin-password
# MEDIAFORGE_GRAFANA_COOKIE_SECURE=true
# MEDIAFORGE_METRICS_TARGET=mediaforge:8020
# MEDIAFORGE_PROMETHEUS_PORT=9090
# MEDIAFORGE_ALERTMANAGER_PORT=9093
# MEDIAFORGE_GRAFANA_PORT=3000
# To enable an outbound Alertmanager webhook, copy and review
# ops/observability/alertmanager/alertmanager.webhook.example.yml first.
# MEDIAFORGE_ALERTMANAGER_CONFIG_FILE=./ops/secrets/alertmanager.yml
# MEDIAFORGE_ALERTMANAGER_WEBHOOK_TOKEN_FILE=./ops/secrets/alertmanager-webhook-token

# Text-to-speech. Windows system mode uses SAPI; deterministic is a review-only tone; http expects JSON {audio_b64}.
# MEDIAFORGE_TTS_MODE=system
# MEDIAFORGE_TTS_URL=https://tts.example.com/synthesize
# MEDIAFORGE_TTS_TOKEN=replace-with-tts-token
# MEDIAFORGE_TTS_TIMEOUT_SECONDS=30

# Lip-sync adapter. HTTP mode requires explicit data-export opt-in.
# MEDIAFORGE_LIPSYNC_MODE=command
# MEDIAFORGE_LIPSYNC_COMMAND=python path/to/lipsync_worker.py
# MEDIAFORGE_LIPSYNC_URL=https://lipsync.example.com/v1/render
# MEDIAFORGE_LIPSYNC_ALLOW_DATA_EXPORT=false
# MEDIAFORGE_LIPSYNC_TIMEOUT_SECONDS=300

# Content Credentials / C2PA. By default MediaForge produces an UNSIGNED
# provenance claim only. The command is run without a shell. {input} is the
# source asset, {manifest} is the MediaForge audit claim, {c2pa_manifest} is the
# C2PA Tool manifest definition, and {output} is the signed media output.
# The production profile uses the isolated signer and verifier clients:
# MEDIAFORGE_C2PA_SIGNER_COMMAND=mediaforge-c2pa-signer-client sign {input} {c2pa_manifest} {output}
# MEDIAFORGE_C2PA_VERIFIER_COMMAND=mediaforge-c2pa-verifier-client verify {input} {c2pa_manifest} {output}
# MEDIAFORGE_C2PA_SIGNER_URL=http://c2pa-signer:8030
# MEDIAFORGE_C2PA_SIGNER_TOKEN_FILE=/var/run/secrets/mediaforge-c2pa-client/signer-token
# MEDIAFORGE_C2PA_VERIFIER_URL=http://c2pa-verifier:8031
# MEDIAFORGE_C2PA_VERIFIER_TOKEN_FILE=/var/run/secrets/mediaforge-c2pa-client/verifier-token
# MEDIAFORGE_C2PA_SIGNER_TIMEOUT_SECONDS=120
# MEDIAFORGE_C2PA_VERIFIER_TRUST_ANCHORS=/var/run/mediaforge-c2pa-trust/trust-anchors.pem
# MEDIAFORGE_C2PA_VERIFIER_TRUST_CONFIG=/var/run/mediaforge-c2pa-trust/trust-config.cfg
# MEDIAFORGE_C2PA_VERIFIER_ALLOWED_LIST=/var/run/mediaforge-c2pa-trust/allowed-list.pem
# MEDIAFORGE_C2PA_PRODUCTION_SIGNER_ATTESTED=false

# Browser collaboration sockets use the OIDC session cookie or authenticate with
# a first WebSocket message, never a bearer token in the URL. Leave empty to allow
# the current host only; add comma-separated Studio origins behind a reverse proxy.
# MEDIAFORGE_ALLOWED_WEBSOCKET_ORIGINS=https://studio.example.com
