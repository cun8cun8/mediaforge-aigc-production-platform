# Copy to ops/staging/.env.provider after a ComfyUI endpoint and reviewed
# workflow registry have been approved. This file is ignored by Git.
MEDIAFORGE_PROVIDERS=comfyui,mock
COMFYUI_BASE_URL=http://host.docker.internal:8188
COMFYUI_WORKFLOW_REGISTRY_PATH=/app/provider-config/comfyui-workflow-registry.json
COMFYUI_REQUIRE_WORKFLOW_PIN=true
COMFYUI_TIMEOUT_SECONDS=180
COMFYUI_POLL_INTERVAL_SECONDS=0.5
COMFYUI_ESTIMATED_COST=0.05
