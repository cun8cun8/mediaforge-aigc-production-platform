# This template is intentionally non-secret. Create a local .env.staging file
# with ops/staging/bootstrap.ps1 before starting the staging Compose stack.
POSTGRES_PASSWORD=replace-with-local-staging-password
REDIS_PASSWORD=replace-with-local-staging-password
MINIO_ROOT_USER=mediaforge-staging
MINIO_ROOT_PASSWORD=replace-with-local-staging-password

MEDIAFORGE_STORAGE_BUCKET=mediaforge-staging-artifacts
MEDIAFORGE_STORAGE_ENDPOINT=http://minio:9000
MEDIAFORGE_DATABASE_URL=postgresql://mediaforge_staging:replace-with-local-staging-password@postgres:5432/mediaforge_staging
MEDIAFORGE_REDIS_URL=redis://:replace-with-local-staging-password@redis:6379/0
AWS_ACCESS_KEY_ID=mediaforge-staging
AWS_SECRET_ACCESS_KEY=replace-with-local-staging-password

# Replace each example token before use. Admin is for operator validation;
# provider is only for the optional worker profile.
MEDIAFORGE_API_KEYS={"replace-staging-admin":{"subject":"staging-operator","role":"admin","tenant_id":"staging"},"replace-staging-provider":{"subject":"staging-worker","role":"provider","tenant_id":"staging"}}
MEDIAFORGE_WORKER_TOKEN=replace-staging-provider
MEDIAFORGE_CALLBACK_SECRET=replace-with-a-long-random-secret
MEDIAFORGE_CALLBACK_MAX_AGE_SECONDS=300

# The staging baseline is intentionally simulation-only. Add the ignored
# .env.provider file only after a real Provider and cost owner are approved.
MEDIAFORGE_PROVIDER=mock
MEDIAFORGE_LLM_MODE=disabled
MEDIAFORGE_PLANNING_MODE=langgraph
MEDIAFORGE_RATE_LIMIT_REQUESTS=120
MEDIAFORGE_RATE_LIMIT_READ_REQUESTS=600
MEDIAFORGE_RATE_LIMIT_WINDOW_SECONDS=60
