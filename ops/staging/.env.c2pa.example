# This file has no private key. Create ops/staging/.env.c2pa with
# ops/c2pa/bootstrap.ps1, then start Compose with docker-compose.c2pa.yml.
MEDIAFORGE_C2PA_SIGNER_COMMAND=mediaforge-c2pa-signer-client sign {input} {c2pa_manifest} {output}
MEDIAFORGE_C2PA_VERIFIER_COMMAND=mediaforge-c2pa-verifier-client verify {input} {c2pa_manifest} {output}
MEDIAFORGE_C2PA_SIGNER_URL=http://c2pa-signer:8030
MEDIAFORGE_C2PA_SIGNER_TOKEN_FILE=/var/run/secrets/mediaforge-c2pa-client/signer-token
MEDIAFORGE_C2PA_VERIFIER_URL=http://c2pa-verifier:8031
MEDIAFORGE_C2PA_VERIFIER_TOKEN_FILE=/var/run/secrets/mediaforge-c2pa-client/verifier-token
MEDIAFORGE_C2PA_SIGNER_TIMEOUT_SECONDS=180

# The default local PEM profile is real cryptographic signing for integration
# testing. It is not a production key-management design. For HSM/KMS, remove
# these two variables and configure exactly one of SIGNER_PATH or SETTINGS_PATH.
MEDIAFORGE_C2PA_SIGNER_PRIVATE_KEY_FILE=/var/run/secrets/mediaforge-c2pa/private-key.pem
MEDIAFORGE_C2PA_SIGNER_CERTIFICATE_FILE=/var/run/secrets/mediaforge-c2pa/signing-chain.pem
MEDIAFORGE_C2PA_SIGNER_ALGORITHM=ps256
# MEDIAFORGE_C2PA_SIGNER_PATH=/opt/mediaforge-c2pa/hsm-signer
# MEDIAFORGE_C2PA_SIGNER_SETTINGS_PATH=/var/run/secrets/mediaforge-c2pa/settings.toml
# For integration tests only, remove the local PEM variables above and set both
# flags below. The built-in C2PA Tool identity is untrusted and production
# acceptance reports this configuration as not ready.
# MEDIAFORGE_C2PA_SIGNER_ALLOW_BUILTIN_TEST_SIGNER=true
# MEDIAFORGE_C2PA_SIGNER_TEST_MODE=true

# Configure a reviewed, hash-verified C2PA trust anchor bundle for independent
# verifier trust evaluation. Run ops/c2pa/install-c2pa-trust-anchors.ps1 first.
# MEDIAFORGE_C2PA_VERIFIER_TRUST_ANCHORS=/var/run/mediaforge-c2pa-trust/trust-anchors.pem
# MEDIAFORGE_C2PA_VERIFIER_TRUST_CONFIG=/var/run/mediaforge-c2pa-trust/trust-config.cfg
# MEDIAFORGE_C2PA_VERIFIER_ALLOWED_LIST=/var/run/mediaforge-c2pa-trust/allowed-list.pem

# Set only after the signer, verifier, and a C2PA-trusted certificate chain have
# passed the verification procedure in ops/c2pa/README.md. This declares that
# operator evidence has been reviewed; it does not replace independent validation.
# MEDIAFORGE_C2PA_PRODUCTION_SIGNER_ATTESTED=true
# MEDIAFORGE_REQUIRE_RELEASE_CONTENT_CREDENTIALS=true
